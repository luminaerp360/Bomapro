# ---- Build Stage ----
FROM node:20-alpine AS builder

RUN apk add --no-cache openssl python3 make g++

WORKDIR /app

# Copy root workspace files
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./

# Copy backend package & config files
COPY bomapro-backend/package.json ./bomapro-backend/
COPY bomapro-backend/nest-cli.json ./bomapro-backend/
COPY bomapro-backend/tsconfig.json ./bomapro-backend/
COPY bomapro-backend/tsconfig.build.json ./bomapro-backend/

# Also copy frontend package.json so workspace resolution succeeds
COPY bomapro-frontend/package.json ./bomapro-frontend/

# Install pnpm and dependencies
RUN npm install -g pnpm@10.26.2
RUN pnpm install --frozen-lockfile

# Copy backend source and seed scripts
COPY bomapro-backend/src/ ./bomapro-backend/src/
COPY bomapro-backend/seed-*.js ./bomapro-backend/

# Build NestJS backend (outputs to bomapro-backend/api/_dist)
RUN pnpm --filter bomapro-backend run build

# ---- Production Stage ----
FROM node:20-alpine AS production

WORKDIR /app

# Create non-root user
RUN addgroup -g 1001 -S appgroup && \
    adduser -S appuser -u 1001 -G appgroup

# Copy built output and dependencies
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/bomapro-backend/api/_dist ./bomapro-backend/api/_dist
COPY --from=builder /app/bomapro-backend/package.json ./bomapro-backend/
COPY --from=builder /app/bomapro-backend/node_modules ./bomapro-backend/node_modules
COPY --from=builder /app/bomapro-backend/seed-*.js ./bomapro-backend/

WORKDIR /app/bomapro-backend

# Switch to non-root user
USER appuser

EXPOSE 3340

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:${PORT:-3340}/health || exit 1

CMD ["node", "api/_dist/main.js"]

